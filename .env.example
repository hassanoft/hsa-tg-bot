# =============================================================
# H$Λ BOT — Configuration d'environnement (version Telegram)
# Copiez ce fichier en ".env" et remplissez vos propres valeurs.
# Ne mettez JAMAIS de vraies clés dans ce fichier .env.example.
# =============================================================

# ---- Identité du bot ----
BOT_NAME=H$Λ BOT
PREFIX=/

# ---- Connexion Telegram ----
# Créez votre bot via @BotFather sur Telegram (commande /newbot), puis
# collez ici le jeton fourni (format: 123456789:AAExempleDeJetonAleatoire).
BOT_TOKEN=

# ---- Propriétaire (OWNER) ----
# Identifiant numérique Telegram du propriétaire (PAS un numéro de téléphone,
# PAS un @username). Pour l'obtenir, envoyez un message à @userinfobot sur Telegram.
OWNER_ID=

# ---- Canal pour /videostatus (optionnel) ----
# Telegram n'a pas d'équivalent au "Statut" WhatsApp. Renseignez ici
# l'identifiant d'un canal Telegram dont H$Λ BOT est administrateur pour
# que /videostatus puisse y publier des vidéos.
STATUS_CHANNEL_ID=

# ---- Serveur HTTP (Render) ----
PORT=3000

# ---- Stockage / persistance ----
# Dossier où sont stockées les données persistantes (base JSON).
# Sur Render, faites pointer ceci vers un "Persistent Disk" monté (ex: /var/data).
DATA_DIR=./data

# ---- Intelligence Artificielle (/ai /ask /chat /translate /summarize ...) ----
# Endpoint compatible "chat completions" (OpenAI-compatible). Laissez vide pour désactiver.
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# Génération d'image (/imagine)
AI_IMAGE_API_URL=https://api.openai.com/v1/images/generations
AI_IMAGE_MODEL=dall-e-3

# Synthèse vocale (/tts)
TTS_API_URL=
TTS_API_KEY=

# ---- Image ----
REMOVEBG_API_KEY=
REMOVEBG_API_URL=https://api.remove.bg/v1.0/removebg
IMAGE_UPSCALE_API_URL=
IMAGE_UPSCALE_API_KEY=

# ---- Téléchargement (yt / tiktok / instagram / facebook / twitter) ----
# Branchez ici une API tierce conforme aux CGU des plateformes concernées.
DOWNLOAD_API_URL=
DOWNLOAD_API_KEY=

# ---- Météo (/weather) ----
WEATHER_API_KEY=
WEATHER_API_URL=https://api.openweathermap.org/data/2.5/weather

# ---- Devises (/currency) ----
CURRENCY_API_URL=https://api.exchangerate.host/latest

# ---- Modération : anti-NSFW (/antinsfw) ----
NSFW_API_URL=
NSFW_API_KEY=

# ---- FFmpeg ----
# Laissez vide pour auto-détection (system ffmpeg puis ffmpeg-static en secours)
FFMPEG_PATH=

# ---- Divers ----
# Nombre max de commandes par utilisateur / fenêtre de temps (anti-spam)
RATE_LIMIT_MAX=8
RATE_LIMIT_WINDOW_MS=10000
